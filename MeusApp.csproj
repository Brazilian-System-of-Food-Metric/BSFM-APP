<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MailKit" Version="4.10.0" />
    <PackageReference Include="MimeKit" Version="4.10.0" />
    <PackageReference Include="YoloDotNet" Version="2.0.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.19.0" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" Version="1.19.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Garante que os modelos de IA sejam levados para o servidor -->
    <None Update="Models\bsfmv1_yolo_final.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Models\yolov10n.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!--
      A v2 vive em v2/ com seus próprios projetos. Sem esta exclusão, o SDK
      globa **/*.cs a partir da raiz e o build da v1 tenta compilar os arquivos
      da v2 — erro CS8802 (mais de um arquivo com top-level statements).
    -->
    <Compile Remove="v2/**/*.cs" />
    <Content Remove="v2/**" />
    <None Remove="v2/**" />
    <EmbeddedResource Remove="v2/**" />
  </ItemGroup>

</Project>
